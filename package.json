{
  "name": "wave-crm",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @wave/web --filter @wave/api dev",
    "dev:web": "pnpm --filter @wave/web dev",
    "dev:api": "pnpm --filter @wave/api dev",
    "build": "pnpm --filter @wave/database build && pnpm --filter @wave/api build && pnpm --filter @wave/web build",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm --filter @wave/api test && pnpm --filter @wave/web test",
    "test:integration": "dotenv -e .env.test.local -- pnpm --filter @wave/api test:integration",
    "test:e2e": "dotenv -e .env.test.local -- playwright test",
    "test:coverage": "pnpm test:coverage:api && pnpm test:coverage:web",
    "test:coverage:api": "pnpm --filter @wave/api build && dotenv -e .env.test.local -- c8 --reporter=lcov --reporter=text-summary --reports-dir=coverage/api --include=apps/api/dist/**/*.js --exclude=apps/api/dist/main.js node --test --test-concurrency=1 apps/api/test/*.test.cjs apps/api/test/integracion/*.test.cjs",
    "test:coverage:web": "pnpm --filter @wave/web test:coverage",
    "test:quality": "pnpm lint && pnpm test && pnpm build",
    "sonar:scan": "pnpm test:coverage && sonar -Dsonar.host.url=http://localhost:9000 -Dsonar.qualitygate.wait=true",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "dotenv -e .env -- pnpm --filter @wave/database generate",
    "db:migrate": "dotenv -e .env.docker -- pnpm --filter @wave/database migrate",
    "db:migrate:deploy": "dotenv -e .env -- pnpm --filter @wave/database migrate:deploy",
    "db:seed": "dotenv -e .env -- pnpm --filter @wave/database seed"
  },
  "devDependencies": {
    "@neon/config": "^1.4.2",
    "@playwright/test": "^1.63.0",
    "@sonar/scan": "4.3.5",
    "@wave/database": "workspace:*",
    "c8": "^12.0.0",
    "dotenv-cli": "^8.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
