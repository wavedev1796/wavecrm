{
  "name": "wave-crm",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @wave/web --filter @wave/api dev",
    "dev:web": "pnpm --filter @wave/web dev",
    "dev:api": "pnpm --filter @wave/api dev",
    "build": "pnpm --filter @wave/database build && pnpm --filter @wave/api build && pnpm --filter @wave/web build",
    "lint": "pnpm -r --if-present lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "dotenv -e .env -- pnpm --filter @wave/database generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @wave/database migrate",
    "db:migrate:deploy": "dotenv -e .env -- pnpm --filter @wave/database migrate:deploy",
    "db:seed": "dotenv -e .env -- pnpm --filter @wave/database seed"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2"
  }
}
