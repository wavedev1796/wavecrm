generator client {
  provider        = "prisma-client-js"
  engineType      = "binary"
  // Cada include se resuelve en la misma consulta (LATERAL JOIN) en vez de una por relación:
  // contra Neon cada ida y vuelta cuesta ~130 ms y la ficha pasaba de 14 consultas.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  VENDEDOR
}

// LOST es recuperable (sigue en el tablero); REJECTED es la decisión de no continuar y va a la papelera.
enum DealStatus {
  OPEN
  WON
  LOST
  REJECTED
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  TASK
}

enum ActivityStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  SUPERSEDED
}

enum StageRequirement {
  CONTACT
  OWNER
  INTERACTION
  NEED
  NEXT_ACTIVITY
  SOLUTION
  BUDGET
  EXPECTED_CLOSE
  PROPOSAL_SENT
}

// Motivo de un cierre, perdido o rechazado: @wave/shared separa LOSS_REASONS y REJECTION_REASONS.
// Conserva el nombre LossReason (y Deal.lossReason) para no renombrar columna ni tipo.
enum LossReason {
  NEGOTIATION
  COMPETITOR
  NO_BUDGET
  NO_RESPONSE
  BAD_TIMING
  OTHER
  NEED_POSTPONED
  PRIORITY_CHANGE
  CLIENT_DECLINED
  PRODUCT_MISMATCH
  REQUIREMENTS_UNMET
  COMMERCIAL_RISK
  OUT_OF_SCOPE
  DO_NOT_CONTACT
  NO_PAYMENT
}

model User {
  id                 String      @id @default(cuid())
  email              String      @unique
  name               String
  passwordHash       String?
  refreshTokenHash   String?
  invitationTokenHash String?    @unique
  invitationExpiresAt DateTime?
  invitationSentAt   DateTime?
  activatedAt        DateTime?
  termsAcceptedAt    DateTime?
  termsVersion       String?
  passwordResetTokenHash String? @unique
  passwordResetExpiresAt DateTime?
  previousPasswordHashes String[] @default([])
  role               UserRole    @default(VENDEDOR)
  active             Boolean     @default(true)
  ownedCompanies     Company[]   @relation("CompanyOwner")
  ownedContacts      Contact[]   @relation("ContactOwner")
  ownedDeals         Deal[]      @relation("DealOwner")
  dealStageChanges   DealStageHistory[]
  assignedActivities Activity[]  @relation("ActivityAssignee")
  createdActivities  Activity[]  @relation("ActivityCreator")
  notes              Note[]
  noteMentions       NoteMention[]
  auditLogs          AuditLog[]
  dealPayments       DealPayment[]
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@index([active, role])
  @@index([invitationExpiresAt])
}

model Company {
  id         String       @id @default(cuid())
  name       String
  legalName  String?
  taxId      String?      @unique
  website    String?
  phone      String?
  email      String?
  province   String?
  city       String?
  address    String?
  tags       String[]     @default([])
  ownerId    String?
  owner      User?        @relation("CompanyOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts   Contact[]
  deals      Deal[]
  activities Activity[]
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([name])
  @@index([ownerId])
  @@index([province, city])
  @@index([tags], type: Gin)
}

enum DocumentType {
  CEDULA
  RUC
  PASAPORTE
}

model Contact {
  id          String       @id @default(cuid())
  firstName   String
  lastName    String
  /// Al menos uno de los dos, email o phone: CHECK "Contact_phone_or_email" (solo en la migración SQL).
  email       String?
  phone       String?
  documentType DocumentType
  documentId  String       @unique
  province    String?
  city        String?
  position    String?
  tags        String[]     @default([])
  companyId   String?
  company     Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  ownerId     String?
  owner       User?        @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  deals       Deal[]
  activities  Activity[]
  notes       Note[]
  attachments Attachment[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([lastName, firstName])
  @@index([companyId])
  @@index([ownerId])
  @@index([email])
  @@index([province, city])
  @@index([tags], type: Gin)
}

model Pipeline {
  id        String   @id @default(cuid())
  name      String
  isDefault Boolean  @default(false)
  stages    Stage[]
  deals     Deal[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isDefault])
}

model Stage {
  id          String   @id @default(cuid())
  name        String
  position    Int
  probability Int      @default(0)
  color       String?
  /// Requisitos para entrar a la etapa; se suman los de las etapas abiertas anteriores.
  requirements StageRequirement[] @default([])
  /// Días sin actividad completada para marcar un negocio abierto «En riesgo»; null = sin alerta.
  /// De 1 a 365: CHECK "Stage_staleDays_range" (solo en la migración SQL).
  staleDays   Int?
  pipelineId  String
  pipeline    Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deals       Deal[]
  historyFrom DealStageHistory[] @relation("HistoryFromStage")
  historyTo   DealStageHistory[] @relation("HistoryToStage")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([pipelineId, position])
  @@index([pipelineId, name])
}

model Deal {
  id            String       @id @default(cuid())
  title         String
  value         Decimal      @db.Decimal(14, 2)
  currency      String       @default("USD")
  status        DealStatus   @default(OPEN)
  expectedClose DateTime?
  closedAt      DateTime?
  lossReason    LossReason?
  lossDetail    String?
  need          String?
  solution      String?
  budget        Decimal?     @db.Decimal(14, 2)
  budgetNote    String?
  decisionMaker String?
  /// Viabilidad según el vendedor; para ganar debe ser true y con evidencia (requisito VIABILITY).
  viable        Boolean?
  viabilityNote String?
  pipelineId    String
  pipeline      Pipeline     @relation(fields: [pipelineId], references: [id], onDelete: Restrict)
  stageId       String
  stage         Stage        @relation(fields: [stageId], references: [id], onDelete: Restrict)
  companyId     String?
  company       Company?     @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  ownerId       String?
  owner         User?        @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  activities    Activity[]
  quotes        Quote[]
  notes         Note[]
  stageHistory  DealStageHistory[]
  attachments   Attachment[]
  items         DealItem[]
  payments      DealPayment[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([pipelineId, stageId, status])
  @@index([companyId])
  @@index([contactId])
  @@index([ownerId, expectedClose])
}

model DealStageHistory {
  id          String   @id @default(cuid())
  dealId      String
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fromStageId String?
  fromStage   Stage?   @relation("HistoryFromStage", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStageId   String
  toStage     Stage    @relation("HistoryToStage", fields: [toStageId], references: [id], onDelete: Restrict)
  changedById String?
  changedBy   User?    @relation(fields: [changedById], references: [id], onDelete: SetNull)
  changedAt   DateTime @default(now())
  reason      String?

  @@index([dealId, changedAt])
}

model DealItem {
  id          String   @id @default(cuid())
  dealId      String
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  description String
  quantity    Decimal  @db.Decimal(12, 2)
  unitPrice   Decimal  @db.Decimal(14, 2)
  discountRate Int     @default(0)
  /// Entero de 0 a 100: CHECK "DealItem_taxRate_range" (solo en la migración SQL).
  taxRate     Int
  position    Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([dealId, position])
}

/// Abono de un negocio, sin comprobante adjunto. El monto es mayor que cero: CHECK "DealPayment_amount_positive".
model DealPayment {
  id          String   @id @default(cuid())
  dealId      String
  deal        Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(14, 2)
  /// Día del pago, a las 00:00 UTC como las demás fechas de calendario.
  paidAt      DateTime
  note        String?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([dealId, paidAt])
}

model Activity {
  id           String         @id @default(cuid())
  type         ActivityType
  status       ActivityStatus @default(PENDING)
  subject      String
  description  String?
  dueAt        DateTime?
  reminderAt   DateTime?
  reminderClaimedAt DateTime?
  reminderSentAt DateTime?
  completedAt  DateTime?
  assigneeId   String?
  assignee     User?          @relation("ActivityAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  /// Quién la registró; las anteriores al 2026-11-01 quedan en null y la línea de tiempo usa el responsable.
  createdById  String?
  createdBy    User?          @relation("ActivityCreator", fields: [createdById], references: [id], onDelete: SetNull)
  companyId    String?
  company      Company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId    String?
  contact      Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId       String?
  deal         Deal?          @relation(fields: [dealId], references: [id], onDelete: SetNull)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([assigneeId, status, dueAt])
  @@index([status, dueAt])
  @@index([reminderAt, reminderSentAt, status])
  @@index([companyId])
  @@index([contactId])
  @@index([dealId])
}

model Quote {
  id        String      @id @default(cuid())
  number    String      @unique
  status    QuoteStatus @default(DRAFT)
  subtotal  Decimal     @db.Decimal(14, 2)
  tax       Decimal     @db.Decimal(14, 2)
  total     Decimal     @db.Decimal(14, 2)
  validUntil DateTime?
  sentAt    DateTime?
  acceptedAt DateTime?
  acceptanceNote String?
  rejectedAt DateTime?
  rejectionNote String?
  requestKey String? @unique
  requestHash String?
  /// Productos con los que se envió: [{ description, quantity, unitPrice, taxRate }]. Las anteriores al 2026-10-25, [].
  items     Json        @default("[]")
  version   Int         @default(1)
  /// Copia inmutable del cliente, emisor y condiciones al momento de generar.
  snapshot  Json        @default("{}")
  dealId    String
  deal      Deal        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([dealId, version])
  @@index([dealId, status])
}

/// Catálogo comercial reusable; no representa existencias ni movimientos de inventario.
model Product {
  id          String     @id @default(cuid())
  code        String     @unique
  description String
  price       Decimal    @db.Decimal(14, 2)
  taxRate     Int
  isActive    Boolean    @default(true)
  dealItems   DealItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([isActive, description])
}

model Note {
  id        String   @id @default(cuid())
  content   String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  mentions  NoteMention[]
  /// Última edición del texto o de las menciones; null si nunca se editó.
  editedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([contactId])
  @@index([dealId])
}

/// Miembro mencionado en una nota. `notifiedAt` marca el aviso enviado: se avisa una sola vez.
model NoteMention {
  noteId     String
  note       Note      @relation(fields: [noteId], references: [id], onDelete: Cascade)
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@id([noteId, userId])
  @@index([userId])
}

model Attachment {
  id        String   @id @default(cuid())
  fileName  String
  mimeType  String
  size      Int
  url       String
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([contactId])
  @@index([dealId])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  changes    Json?
  ipAddress  String?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
}
