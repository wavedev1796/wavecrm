{
  "info": {
    "_postman_id": "ae75665f-ef66-4b27-9745-d5fd77ec9c07",
    "name": "Wave CRM - Sprint 1",
    "description": "Pruebas del Sprint 1: salud, autenticación JWT, roles, refresh/logout, CRUD de usuarios, invitaciones, activación y desactivación. Ejecutar las carpetas en orden. Antes de la carpeta 04, copiar desde la consola del API el token de la invitación a la variable inviteToken del environment.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Salud",
      "item": [
        {
          "name": "Healthcheck",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('API responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('Estado OK', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 - Autenticación administrador",
      "item": [
        {
          "name": "Login administrador",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login correcto', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.environment.set('adminAccessToken', data.accessToken);",
                  "  pm.environment.set('adminRefreshToken', data.refreshToken);",
                  "  pm.test('Rol ADMIN', () => pm.expect(data.user.role).to.eql('ADMIN'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Usuario autenticado",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminAccessToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": { "exec": ["pm.test('Devuelve el administrador', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().role).to.eql('ADMIN'); });"] }
            }
          ]
        },
        {
          "name": "Rotar refresh token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{adminRefreshToken}}\"\n}" },
            "url": "{{baseUrl}}/auth/refresh"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Refresh correcto', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  "  const data = pm.response.json();",
                  "  pm.environment.set('adminAccessToken', data.accessToken);",
                  "  pm.environment.set('adminRefreshToken', data.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - Autorización y roles",
      "item": [
        {
          "name": "Usuarios sin token - 401",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/users" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Requiere autenticación', () => pm.response.to.have.status(401));"] } }]
        },
        {
          "name": "Login vendedor",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{sellerEmail}}\",\n  \"password\": \"{{sellerPassword}}\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Vendedor inicia sesión', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.environment.set('sellerAccessToken', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Vendedor intenta listar usuarios - 403",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{sellerAccessToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Solo ADMIN puede gestionar usuarios', () => pm.response.to.have.status(403));"] } }]
        }
      ]
    },
    {
      "name": "03 - CRUD e invitación",
      "item": [
        {
          "name": "Listar usuarios",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminAccessToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users?page=1&limit=20"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Respuesta paginada', () => { pm.response.to.have.status(200); const data = pm.response.json(); pm.expect(data.data).to.be.an('array'); pm.expect(data.meta).to.have.property('total'); });"] } }]
        },
        {
          "name": "Invitar usuario",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminAccessToken}}", "type": "string" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Usuario Postman\",\n  \"email\": \"{{invitedEmail}}\",\n  \"role\": \"VENDEDOR\"\n}" },
            "url": "{{baseUrl}}/users"
          },
          "event": [
            {
              "listen": "prerequest",
              "script": { "exec": ["pm.environment.set('invitedEmail', `postman.${Date.now()}@wave.local`);"] }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Usuario pendiente creado', () => { pm.response.to.have.status(201); pm.expect(pm.response.json().status).to.eql('pending'); });",
                  "if (pm.response.code === 201) pm.environment.set('invitedUserId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Consultar usuario",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminAccessToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/users/{{invitedUserId}}"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Consulta correcta', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().email).to.eql(pm.environment.get('invitedEmail')); });"] } }]
        },
        {
          "name": "Editar usuario",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminAccessToken}}", "type": "string" }] },
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Usuario Postman Editado\",\n  \"email\": \"{{invitedEmail}}\",\n  \"role\": \"VENDEDOR\"\n}" },
            "url": "{{baseUrl}}/users/{{invitedUserId}}"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Usuario editado', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().name).to.eql('Usuario Postman Editado'); });"] } }]
        },
        {
          "name": "Reenviar invitación",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminAccessToken}}", "type": "string" }] },
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/users/{{invitedUserId}}/resend-invitation"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Invitación reenviada', () => pm.response.to.have.status(201));"] } }]
        }
      ]
    },
    {
      "name": "04 - Activación (requiere inviteToken)",
      "description": "Después de Reenviar invitación, copia de la consola del API únicamente el valor situado después de ?token= y colócalo en la variable inviteToken del environment.",
      "item": [
        {
          "name": "Validar invitación",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/users/invitations/{{inviteToken}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Invitación válida', () => { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.have.property('name'); });"] } }]
        },
        {
          "name": "Activar cuenta",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"password\": \"{{invitedPassword}}\",\n  \"passwordConfirmation\": \"{{invitedPassword}}\"\n}" },
            "url": "{{baseUrl}}/users/invitations/{{inviteToken}}/activate"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Cuenta activada', () => pm.response.to.have.status(200));"] } }]
        },
        {
          "name": "Token de invitación no se reutiliza - 400",
          "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/users/invitations/{{inviteToken}}" },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Token consumido', () => pm.response.to.have.status(400));"] } }]
        },
        {
          "name": "Login del usuario invitado",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{invitedEmail}}\",\n  \"password\": \"{{invitedPassword}}\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Cuenta invitada puede iniciar sesión', () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) pm.environment.set('invitedAccessToken', pm.response.json().accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05 - Desactivación y reactivación",
      "item": [
        {
          "name": "Desactivar usuario",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminAccessToken}}", "type": "string" }] },
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/users/{{invitedUserId}}/deactivate"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Usuario desactivado', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().active).to.eql(false); });"] } }]
        },
        {
          "name": "Access token del desactivado - 401",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{invitedAccessToken}}", "type": "string" }] },
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/auth/me"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Desactivación inmediata', () => pm.response.to.have.status(401));"] } }]
        },
        {
          "name": "Login desactivado - 401",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{invitedEmail}}\",\n  \"password\": \"{{invitedPassword}}\"\n}" },
            "url": "{{baseUrl}}/auth/login"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Usuario desactivado no inicia sesión', () => pm.response.to.have.status(401));"] } }]
        },
        {
          "name": "Reactivar usuario",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminAccessToken}}", "type": "string" }] },
            "method": "PATCH",
            "header": [],
            "url": "{{baseUrl}}/users/{{invitedUserId}}/reactivate"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Usuario reactivado', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().active).to.eql(true); });"] } }]
        }
      ]
    },
    {
      "name": "06 - Limpieza y logout",
      "item": [
        {
          "name": "Eliminar usuario de prueba",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{adminAccessToken}}", "type": "string" }] },
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/users/{{invitedUserId}}"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Usuario eliminado', () => pm.response.to.have.status(204));"] } }]
        },
        {
          "name": "Logout administrador",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{adminRefreshToken}}\"\n}" },
            "url": "{{baseUrl}}/auth/logout"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Logout correcto', () => pm.response.to.have.status(204));"] } }]
        },
        {
          "name": "Refresh revocado - 401",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refreshToken\": \"{{adminRefreshToken}}\"\n}" },
            "url": "{{baseUrl}}/auth/refresh"
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('Refresh revocado', () => pm.response.to.have.status(401));"] } }]
        }
      ]
    }
  ]
}
