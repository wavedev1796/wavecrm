# Local: postgresql://wave:wave@localhost:5432/wavecrm?schema=public
# Produccion: usa la URL pooled de Neon y DIRECT_URL para migraciones.
DATABASE_URL="postgresql://wave:wave@localhost:5432/wavecrm?schema=public"
DIRECT_URL="postgresql://wave:wave@localhost:5432/wavecrm?schema=public"
API_PORT=4000
# Secreto para firmar los JWT (access + refresh). Generar uno robusto en produccion.
JWT_SECRET="cambia-este-secreto-en-produccion"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
CORS_ORIGIN="http://localhost:3000"
# URL pública de la web usada en el enlace de invitación.
APP_URL="http://localhost:3000"
# En producción configura Resend. Sin clave, desarrollo imprime el enlace en la consola del API.
RESEND_API_KEY=""
EMAIL_FROM="Wave CRM <no-reply@example.com>"

