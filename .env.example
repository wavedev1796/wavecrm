# Desarrollo: cadenas de la rama `development` de Neon (DATABASE_URL pooled, DIRECT_URL directa).
# Ver docs/Infraestructura/Neon - base de datos compartida.md. `pnpm db:migrate` usa .env.docker.
DATABASE_URL="postgresql://wave:wave@localhost:5432/wavecrm?schema=public"
DIRECT_URL="postgresql://wave:wave@localhost:5432/wavecrm?schema=public"
API_PORT=4000
# Secreto para firmar los JWT (access + refresh). Generar uno robusto en produccion.
JWT_SECRET="cambia-este-secreto-en-produccion"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
CORS_ORIGIN="http://localhost:3000"
# URL pública de la web usada en el enlace de invitación.
APP_URL="http://localhost:3000"
# SMTP local: Mailpit se levanta con Docker y muestra los correos en http://localhost:8025.
# En un proveedor real usa el host, puerto, usuario y contraseña SMTP que te entregue.
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Wave CRM <no-reply@localhost>"

